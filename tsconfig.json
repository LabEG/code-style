{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "types": [
            "node"
        ]
    },
    "include": [
        "tests/**/*.ts",
        "tests/**/*.tsx"
    ]
}
