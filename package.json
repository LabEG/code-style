{
    "name": "@labeg/code-style",
    "version": "7.1.0",
    "author": "Eugene Labutin",
    "license": "MIT",
    "homepage": "https://github.com/LabEG/code-style#readme",
    "description": "Code styles rules for difference linters, for create best code quality",
    "type": "module",
    "main": "eslint.config.js",
    "exports": {
        ".": {
            "import": "./eslint.config.js",
            "require": "./eslint.config.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "eslint.config.js",
        ".editorconfig",
        ".remarkrc",
        ".prettierrc",
        "LICENSE",
        "README.md",
        "SECURITY.md",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=20.19.0",
        "npm": ">=9.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LabEG/code-style.git"
    },
    "bugs": {
        "url": "https://github.com/LabEG/code-style/issues"
    },
    "lint-staged": {
        "./tests/**/*.(ts|tsx|js|jsx)": [
            "eslint tests/**"
        ]
    },
    "scripts": {
        "test": "eslint tests/**",
        "release": "cliff-jumper --name '@labeg/code-style' --package-path '.' --no-skip-changelog --no-skip-tag",
        "prepare": "husky"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0"
    },
    "dependencies": {
        "@eslint-react/eslint-plugin": "^5.28.1",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint": "^10.13.0",
        "eslint-plugin-jsx-a11y-x": "^0.2.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "typescript-eslint": "^8.71.2"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@favware/cliff-jumper": "^6.1.0",
        "@stylistic/eslint-plugin-migrate": "^4.4.1",
        "@types/node": "^20.19.0",
        "@types/react": "^19.3.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "react": "^19.3.1",
        "typescript": "^6.0.3"
    },
    "keywords": [
        "code style",
        "linters",
        "eslint"
    ]
}
